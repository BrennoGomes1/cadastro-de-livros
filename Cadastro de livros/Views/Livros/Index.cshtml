@model IEnumerable<CadastroDeLivros.Models.Livro>

@{
    ViewData["Title"] = "Lista de Livros";
}

<h2> Lista de Livros</h2>

<a asp-action="Create" class="btn btn-primary mb-3">+ Novo Livro</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Título</th>
            <th>Autor</th>
            <th>Ano</th>
            <th>Gênero</th>
            <th>Preço</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var livro in Model)
        {
            <tr>
                <td>@livro.Titulo</td>
                <td>@livro.Autor</td>
                <td>@livro.AnoPublicacao</td>
                <td>@livro.Genero</td>
                <td>@livro.Preco.ToString("C")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@livro.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@livro.Id" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>